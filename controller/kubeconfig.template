apiVersion: v1
kind: Config
clusters:
  - name: snucse-zest
    cluster:
      certificate-authority-data: 
      server: https://zest.snucse.org:6443
users:
  - name: snucse-id
    user:
      exec:
        apiVersion: client.authentication.k8s.io/v1beta1
        command: kubectl
        args:
          - oidc-login
          - get-token
          - --oidc-issuer-url=https://id.snucse.org/o
          - --oidc-client-id=kubernetes-oidc
          - --oidc-client-secret=kubernetes-oidc
          - --oidc-extra-scope=email
          - --oidc-extra-scope=groups
          - --oidc-use-pkce
contexts:
  - name: snucse-zest-{{ . }}
    context:
      cluster: snucse-zest
      user: snucse-id
      namespace: ws-{{ . }}
current-context: snucse-zest-{{ . }}
